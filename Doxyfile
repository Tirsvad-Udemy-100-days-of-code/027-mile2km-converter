# Doxygen configuration for the miles to kilometers converter.
# Build with:  doxygen Doxyfile      (HTML output goes to docs/doxygen/html)
PROJECT_NAME           = "Miles to Kilometer Converter"
PROJECT_BRIEF          = "Tkinter GUI that converts miles to kilometers (Udemy 100 Days of Code, day 27)"
OUTPUT_DIRECTORY       = docs/doxygen
INPUT                  = src
FILE_PATTERNS          = *.py
RECURSIVE              = YES
OPTIMIZE_OUTPUT_JAVA   = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
AUTOLINK_SUPPORT       = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
